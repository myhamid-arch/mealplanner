# Environment variables (ARC-9). Copy to .env and fill in; .env is git-ignored.

# PostgreSQL 16 connection string. Matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mealplanner

# Anthropic API key. Leave empty to let the SDK resolve credentials from its other sources.
ANTHROPIC_API_KEY=
# Model for recipe generation, insights and the agent.
ANTHROPIC_MODEL=claude-opus-5
# Reasoning effort for the admin agent.
AGENT_EFFORT=high

# Public base URL of the web app.
APP_URL=http://localhost:3000
# Secret for signing sessions. Generate one, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# Optional email delivery for magic links and invites (BLD-8 R-6).
EMAIL_FROM=
EMAIL_SERVER=

# Set to 1 to run the live LLM evals (AGT-9).
RUN_LLM_EVALS=0
